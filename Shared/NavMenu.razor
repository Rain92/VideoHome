<header class="top-nav">
    @* The iconify script swaps its placeholder span out for an <svg>, taking any
       styling hooks on it with it - so the tile is a wrapper we own instead. *@
    <a class="top-nav-brand" href="">
        <span class="brand-mark" aria-hidden="true">
            <span class="iconify" data-icon="material-symbols:movie" data-width="20" data-height="20"></span>
        </span>
        <span class="brand-text">VideoHome</span>
    </a>

    <button class="top-nav-toggler" title="Menu" @onclick="ToggleNavMenu" aria-expanded="@(!collapseNavMenu)">
        <span class="iconify" data-icon="material-symbols:menu" data-width="24" data-height="24" aria-hidden="true"></span>
    </button>

    <nav class="top-nav-links @(collapseNavMenu ? "is-collapsed" : "")" @onclick="CloseNavMenu">
        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                    <span class="iconify" data-icon="material-symbols:home" data-width="20" data-height="20" aria-hidden="true"></span>
                    <span>Home</span>
                </NavLink>

                <NavLink class="nav-item" href="history">
                    <span class="iconify" data-icon="material-symbols:history" data-width="20" data-height="20" aria-hidden="true"></span>
                    <span>History</span>
                </NavLink>

                @* A plain link, not a NavLink: clearing the cookie needs a real request
                   to /logout, which an in-circuit navigation would skip. *@
                <a class="nav-item" href="logout">
                    <span class="iconify" data-icon="material-symbols:door-open" data-width="20" data-height="20" aria-hidden="true"></span>
                    <span>Logout</span>
                </a>

                <div class="top-nav-greeting" title="Signed in as @context.User.Identity?.Name">
                    <span class="iconify" data-icon="material-symbols:person" data-width="20" data-height="20" aria-hidden="true"></span>
                    <span class="greeting-text">@context.User.Identity?.Name</span>
                </div>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-item" href="login">
                    <span class="iconify" data-icon="material-symbols:login" data-width="20" data-height="20" aria-hidden="true"></span>
                    <span>Login</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@code {
    private bool collapseNavMenu = true;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }
}
