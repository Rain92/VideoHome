{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VideoMapping": {
    "VideoPath": "/home/andreas/Videos",
    "MapTo": "/video"
  },
  "VideoState": {
    "FilePath": "/home/andreas/.local/share/VideoHome/videostate.json",
    "SaveIntervalSeconds": 2
  }
}
