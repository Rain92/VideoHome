@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@using VideoHome.Data
@using VideoHome.Services
@using YoutubeExplode
@using YoutubeExplode.Videos.Streams
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<SyncVideo> logger
@inject ToastService ToastService
@inject AppHubToken HubToken
@inject YoutubeStreamService Youtube

<div class="watch-layout @(theaterMode ? "is-theater" : null)">

    <section class="watch-player">
        <header class="watch-player-header">
            @if (HasVideo)
            {
                <span class="source-badge @(IsYoutubeSource ? "is-youtube" : "is-local")">
                    <i class="@(IsYoutubeSource ? "fa-brands fa-youtube" : "fa-solid fa-film")"></i>
                    @(IsYoutubeSource ? "YouTube" : "Local")
                </span>
            }
            <h2 class="watch-title @(HasVideo ? null : "is-idle")" title="@videoSourceTitle">
                @(HasVideo ? videoSourceTitle : "Nothing playing")
            </h2>
            <div class="watch-actions">
                <button type="button"
                        class="icon-btn @(ambientEnabled ? "is-active" : null)"
                        title="@(ambientEnabled ? "Turn off ambient light" : "Turn on ambient light")"
                        aria-label="@(ambientEnabled ? "Turn off ambient light" : "Turn on ambient light")"
                        aria-pressed="@(ambientEnabled ? "true" : "false")"
                        @onclick="ToggleAmbient">
                    <i class="fa-solid fa-lightbulb"></i>
                </button>

                <button type="button"
                        class="icon-btn @(theaterMode ? "is-active" : null)"
                        title="@(theaterMode ? "Exit theatre mode" : "Theatre mode")"
                        aria-label="@(theaterMode ? "Exit theatre mode" : "Theatre mode")"
                        aria-pressed="@(theaterMode ? "true" : "false")"
                        @onclick="ToggleTheater">
                    <i class="@(theaterMode ? "fa-solid fa-compress" : "fa-solid fa-expand")"></i>
                </button>
            </div>
        </header>

        <div class="video-stage">
            <div class="video-shell">
                @* Backlight. ambient.js paints a downscaled copy of the current frame
                   here and CSS blurs it out past the edges. Left alone by Blazor: the
                   markup never changes, only the pixels. *@
                <canvas class="video-ambient" width="32" height="18" aria-hidden="true"></canvas>

                @* is-paused keeps the skip overlay visible while the native controls
                   are. A class rather than :has(video:paused) because :paused is
                   Safari-only - and as one invalid selector in a shared rule it would
                   take the :hover reveal down with it in Chrome and Firefox. *@
                <div class="video-frame @(videoState.Paused ? "is-paused" : null)">
                    @* preload=auto because the sync barrier depends on it: a client holds
                       *paused* at the agreed position while it buffers, and under the
                       default the browser is free to fetch little more than metadata
                       until something plays - so the hold would expire having buffered
                       nothing and start behind after all. dash.js fills its own buffer
                       regardless, but a plain file is the browser's decision. *@
                    <BlazoredVideo @ref="videoRef" controls playsinline
                                   webkit-playsinline="true"
                                   muted
                                   Preload="PreloadTypes.Auto"
                                   EventFired="OnEvent"
                                   VideoEventOptions="options">
                        @* Omitted for a DASH manifest: dash.js owns the element's src there,
                           and letting the browser try to load an .mpd as video/mp4 first only
                           earns a failed request. *@
                        @if (!IsDashSource)
                        {
                            <source src="@videoSource" type="video/mp4"/>
                        }
                        <!-- Caption files -->
                        @for (var i = 0; i < videoCaptions.Count; i++)
                        {
                            var (lang, path) = videoCaptions[i];
                            <track @key="path" kind="subtitles" label="@lang" srclang="@SrcLang(lang)" src="@path"
                                   default="@(i == 0)"/>
                        }
                    </BlazoredVideo>

                    @* On the video rather than in the native control bar, because the
                       bar is closed shadow DOM: controlslist can only remove built-in
                       items, nothing can be added. CSS reveals this whenever the native
                       controls are showing - on hover, or while paused. *@
                    @if (HasVideo)
                    {
                        <button type="button"
                                class="player-skip-back"
                                title="Back @(SKIP_BACK_SECONDS)s"
                                aria-label="Skip back @(SKIP_BACK_SECONDS) seconds"
                                @onclick="SkipBack">
                            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                            <span class="player-skip-num">@SKIP_BACK_SECONDS</span>
                        </button>
                    }

                    @* The hold is usually too short to notice, but on a slow connection
                       it needs to look like waiting rather than like the player breaking. *@
                    @if (IsHoldingForSync)
                    {
                        <div class="sync-wait" role="status">
                            <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
                            <span>Waiting for everyone to buffer…</span>
                        </div>
                    }

                    @if (!HasVideo)
                    {
                        <div class="video-placeholder">
                            <i class="fa-solid fa-clapperboard"></i>
                            <p class="video-placeholder-title">Nothing playing yet</p>
                            <p class="video-placeholder-hint">
                                Pick something from <strong>Local videos</strong>, or paste a YouTube link.
                                Everyone connected watches along.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <aside class="watch-side">

        <section class="card-panel side-panel">
            <div class="side-panel-title-row">
                <h3 class="side-panel-title"><i class="fa-solid fa-users"></i> Watching now</h3>
                <span class="count-pill">@connectedUsers.Count</span>
            </div>

            @if (connectedUsers.Count == 0)
            {
                <p class="panel-empty">Nobody connected.</p>
            }
            else
            {
                <ul class="user-list">
                    @foreach (var user in connectedUsers)
                    {
                        <li class="user-row" @key="user.Username">
                            <span class="user-avatar" style="--avatar-hue: @AvatarHue(user.Username)" aria-hidden="true">
                                @Initial(user.Username)
                            </span>
                            <span class="user-name">@user.Username</span>
                            @if (user.NumConnctions > 1)
                            {
                                <span class="user-devices" title="@user.NumConnctions open tabs">
                                    @user.NumConnctions tabs
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card-panel side-panel">
            <h3 class="side-panel-title"><i class="fa-brands fa-youtube"></i> YouTube</h3>
            <div class="youtube-row">
                <BootstrapInput
                    TValue="string"
                    PlaceHolder="Paste a YouTube link"
                    @bind-Value="@streamInputBoxContent"/>
                <button class="btn btn-primary" @onclick="PlayYoutube">
                    <i class="fa-solid fa-play"></i> Play
                </button>
            </div>
        </section>

        <section class="card-panel side-panel">
            <h3 class="side-panel-title"><i class="fa-solid fa-cloud-arrow-up"></i> Upload</h3>
            <ButtonUpload TValue="string" DisplayText="Upload" OnChange="@UploadFiles"
                          ShowUploadFileList="false" BrowserButtonText="Upload"
                          BrowserButtonIcon="fa-solid fa-cloud-arrow-up"></ButtonUpload>
            @if (isUploading)
            {
                <div class="upload-status">
                    <i class="fa-solid fa-circle-notch fa-spin"></i> Uploading video…
                </div>
            }
        </section>

        <section class="card-panel side-panel tree-panel">
            <div class="side-panel-title-row">
                <h3 class="side-panel-title"><i class="fa-solid fa-folder-open"></i> Local videos</h3>
                <button class="btn btn-primary btn-sm" @onclick="NextVideo">
                    <i class="fa-solid fa-forward-step"></i> Next
                </button>
            </div>
            <div class="tree-scroll">
                <TreeView TItem="FileTreeViewItem"
                          Items="@TreeViewItems" ShowIcon="true"
                          ClickToggleNode="true"
                          OnTreeItemClick="@ItemClicked"/>
            </div>
        </section>

    </aside>
</div>


@code {
    // How far the back button jumps. Kept as an int so the markup can print it into
    // the label and the tooltip without formatting it first.
    private const int SKIP_BACK_SECONDS = 10;

    private readonly Dictionary<VideoEvents, VideoStateOptions> options = new();
    private VideoState videoState = new();

    // > 0 while we drive the player (remote update or source switch). Anything it
    // raises in that window is our own doing, not the user's - never send it back.
    private int suppressSendDepth;

    // The events our own driving will still make the player raise after the handler
    // has returned: Seeked after a seek, Playing once buffering allows, Pause after
    // pausing. The fixed tail window this replaces was wrong in both directions - on
    // a slow connection the player could still be buffering when it closed, and the
    // stale events then leaked out as if the user had acted, which is what created
    // the "have to pause/play to resync" drift after skipping around.
    private readonly HashSet<VideoEvents> expectedSettleEvents = new();
    private readonly object settleLock = new();
    private DateTimeOffset settleDeadline = DateTimeOffset.MinValue;

    // Safety valve: if a waited-for event never arrives (seek dropped, autoplay
    // refused, broken source), suppression must not leave this client mute forever.
    private const double SETTLE_TIMEOUT_SECONDS = 10;

    // Scrubbing fires Seeking once per step, and publishing each one made the other
    // side seek and rebuffer at every intermediate stop - falling further behind with
    // each hop. Held briefly so only the position the user settles on is sent.
    private const int SEEK_SEND_DEBOUNCE_MS = 300;
    private CancellationTokenSource? seekSendDebounce;
    private bool pendingSeekSend;

    // Orders this client's own sends (the event handlers that produce them are
    // fire-and-forget, so two sends can leave in either order) and records the last
    // hub state we applied, so the server can drop reports that were overtaken on
    // the network. See VideoStateDto.Version.
    private long clientSequence;
    private long lastAppliedVersion;

    // The sync barrier, client half. When a state resumes playback somewhere the clients
    // may not have buffered - the server decides that and marks it RequiresSync - this
    // client holds the playhead at the agreed position, waits for the browser to buffer,
    // and reports in; the hub releases everyone once the last of them has answered.
    // Skipping the hold is what used to let whoever did the seeking - already holding
    // the media it seeked into - run ahead of a client that still had to fetch it, by
    // however long that fetch took.
    //
    // A plain resume from a spot nobody moved away from never holds: both sides have
    // the media, so the only thing a hold could add there is a stutter.
    private long? holdingForVersion;
    private CancellationTokenSource? holdCts;

    // Guards against the pathological cases: a release that arrives before we even
    // start holding (we were not yet in the hub's client list when it went out), and
    // one that never arrives at all.
    private long lastReleasedVersion;

    private bool IsHoldingForSync => holdingForVersion is not null;

    // How long a client may buffer before it reports in regardless. Playing unbuffered
    // is no worse than the old behaviour, whereas holding everyone indefinitely is.
    private const int READY_TIMEOUT_MS = 4000;

    // Backstop for a release that never comes - a dropped message, or a client that
    // stopped answering without disconnecting. Every client reports within
    // READY_TIMEOUT_MS of its own hold starting, and the holds start within a round
    // trip of each other, so anything past this is a fault rather than slow buffering.
    private const double RELEASE_FALLBACK_SECONDS = 4;

    // And if even the forced release goes unanswered, the hub is not going to reply.
    private const double FORCED_RELEASE_GRACE_SECONDS = 2;

    // PausePlayback on an already-paused element raises no Pause event, so registering
    // an expectation for one would keep this client mute until the settle deadline.
    // Tracked separately because videoState.Paused only catches up when the event lands.
    private bool pauseIssued;

    // Completed by the LoadedMetadata video event. Reload/seek/play calls made right
    // after ReloadControl() race the browser actually fetching the new source; a fixed
    // Task.Delay either wastes time or (worse) is too short and the seek is silently
    // dropped because the element isn't ready yet.
    private readonly List<TaskCompletionSource<bool>> pendingVideoReadyWaiters = new();

    private BlazoredVideo videoRef = null!;
    private string? streamInputBoxContent = "";
    private HubConnection? hubConnection;
    private string username = "Invalid";
    string? videoSource = "";
    string videoSourceTitle = "";
    bool isMobile;

    List<(string, string)> videoCaptions = new();

    DotNetObjectReference<SyncVideo>? dotnetRef;

    // Purely presentational: hides the side rail so the video gets the full width
    // and sits centred. Nothing about the sync state depends on it.
    private bool theaterMode;

    private void ToggleTheater() => theaterMode = !theaterMode;

    // Mirrors what ambient.js has in localStorage; read back in OnInitializedAsync
    // so the button starts out matching the backlight that's actually running. Starts
    // false to match ambient.js's own default - the backlight is opt-in.
    private bool ambientEnabled = false;

    private async Task ToggleAmbient()
    {
        ambientEnabled = !ambientEnabled;
        try
        {
            await JS.InvokeVoidAsync("videoHome.setAmbient", ambientEnabled);
        }
        catch (Exception ex)
        {
            // The button would otherwise sit there lying about the backlight's state.
            logger.LogWarning("Could not apply the ambient setting: {Error}", ex.Message);
            ambientEnabled = !ambientEnabled;
        }
    }

    // Jumps this client back and publishes where it landed, so everyone rewinds
    // together - the point of the button is catching the line nobody heard.
    private async Task SkipBack()
    {
        if (!HasVideo || !await WaitForVideoInteropAsync())
            return;

        try
        {
            // Read the position off the element rather than trusting videoState: that
            // one only advances when the player raises TimeUpdate, so it can be a few
            // hundred ms behind, and the jump would be off by that much.
            var target = Math.Max(0, await videoRef.GetCurrentTimeAsync() - SKIP_BACK_SECONDS);

            // A scrub send still in its debounce window would republish the pre-jump
            // position right after the forced send below.
            CancelPendingSeekSend();

            // The Seeking/Seeked (and Playing, once buffered) this seek raises are our
            // own doing; the forced send below is what tells the other side.
            var settle = new List<VideoEvents> { VideoEvents.Seeked };
            if (!videoState.Paused)
                settle.Add(VideoEvents.Playing);
            BeginSettleSuppression(settle);

            await videoRef.SetCurrentTimeAsync(target);

            // The Seeking event that follows carries this too, but SendState below
            // reads the cached state and would otherwise publish the old position.
            videoState.CurrentTime = target;
        }
        catch (Exception ex)
        {
            logger.LogWarning("Skipping back failed: {Error}", ex.Message);
            return;
        }

        // Forced: a click is an explicit action, and it can land while suppression from
        // a state we just applied is still active - the player's own Seeking event would
        // then be held back and only this client would move.
        await SendState(force: true);
    }

    private bool HasVideo => !string.IsNullOrEmpty(videoSource);

    // PlayYoutube points both clients at our own /youtube/{id} proxy route, so the
    // prefix is what distinguishes a stream from a file off disk.
    private bool IsYoutubeSource => videoSource?.StartsWith("/youtube/", StringComparison.Ordinal) == true;

    // A DASH manifest is handed to dash.js instead of to the element directly. Kept as a
    // suffix check on the source rather than a separate flag so it survives a source that
    // arrived from the hub or from persisted state, not just one this client chose.
    private bool IsDashSource => videoSource?.EndsWith("/manifest.mpd", StringComparison.Ordinal) == true;

    // The single place a source reaches the browser. dash.js has to attach instead of the
    // element loading a URL, and a browser without Media Source Extensions cannot run it at
    // all - so that case drops to the muxed stream. videoSource deliberately keeps naming the
    // manifest either way: it is what the shared state holds, the other client may well
    // support DASH, and every comparison against incoming state reads it.
    private async Task ApplySourceToPlayer(string src)
    {
        if (!IsDashSource)
        {
            await DetachDash();
            await videoRef.SetSrcAsync(src);
            return;
        }

        bool attached;
        try
        {
            attached = await JS.InvokeAsync<bool>("videoHome.attachDash", src);
        }
        catch (Exception ex)
        {
            logger.LogWarning("Client: dash.js could not be started: {Error}", ex.Message);
            attached = false;
        }

        if (attached)
            return;

        // "/youtube/{id}/manifest.mpd" -> "/youtube/{id}", the 360p single-file route.
        var muxed = src[..src.LastIndexOf('/')];
        logger.LogInformation("Client: no DASH support here, falling back to {Source}.", muxed);
        await videoRef.SetSrcAsync(muxed);
    }

    private async Task DetachDash()
    {
        try
        {
            await JS.InvokeVoidAsync("videoHome.detachDash");
        }
        catch (Exception ex)
        {
            // Nothing was attached, or the circuit is going away. Neither should block the
            // source that is about to load.
            logger.LogDebug("Client: detaching dash.js failed: {Error}", ex.Message);
        }
    }

    private static string Initial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : char.ToUpperInvariant(name.Trim()[0]).ToString();

    // Gives each person a stable colour so the same name always looks the same,
    // here and on everyone else's screen.
    private static int AvatarHue(string name)
    {
        var hash = 0;
        foreach (var c in name)
            hash = (hash * 31 + c) % 360;

        return hash;
    }

    private async Task PlayYoutube()
    {
        var videoId = YoutubeStreamService.TryParseVideoId(streamInputBoxContent);
        if (videoId is null)
        {
            await ToastService.Error("Youtube", "That does not look like a YouTube link or video id.");
            return;
        }

        try
        {
            // Resolve here so a bad link is reported now, while someone is looking at the
            // screen, rather than silently becoming a video that will not load. Resolving also
            // fills the server's cache, so the manifest request that follows is already warm.
            var resolved = await Youtube.ResolveDashAsync(videoId, CancellationToken.None);
            if (resolved is null)
            {
                await ToastService.Error("Youtube", "That video has no stream this player can use.");
                return;
            }

            // Point both of us at our own server. The URL YouTube hands back is signed for
            // this machine's IP and expires within hours, so sending it to the other side -
            // which is what used to happen - could never have played there.
            await SetVideoSource($"/youtube/{videoId}/manifest.mpd", setCaptions: false, title: resolved.Title);
        }
        catch (Exception ex)
        {
            // Previously this method had no handling at all, so a failure took the whole
            // page down with it.
            logger.LogError(ex, "Could not load youtube video {VideoId}.", videoId);
            await ToastService.Error("Youtube", "Could not load that video.");
        }
    }

    private async Task ItemClicked(TreeViewItem<FileTreeViewItem> treeitem)
    {
        var item = treeitem.Value;
        if (item.ItemType == FileTreeViewItem.NodeType.File)
        {
            logger.LogInformation($"Item pressed: {item.Path}");
            await SetVideoSource(item.Path, true);
        }
        else
        {
            logger.LogInformation("Folder clicked!");
        }
    }

    private async Task NextVideo()
    {
        logger.LogInformation("Next Video pressed");
        var path = videoSource;
        if (string.IsNullOrEmpty(path))
            return;

        foreach (var tree in TreeViewItems)
        {
            var nextVideoPath = FindNextVideo(path, tree);
            if (!string.IsNullOrEmpty(nextVideoPath))
            {
                await SetVideoSource(nextVideoPath, true);
                return;
            }
        }
    }

    private string? FindNextVideo(string path, TreeViewItem<FileTreeViewItem> tree)
    {
        for (var i = 0; i < tree.Items?.Count(); i++)
        {
            var item = tree.Items[i];
            if (item.Value?.ItemType == FileTreeViewItem.NodeType.File && item.Value?.Path == path)
            {
                if (i + 1 < tree.Items?.Count() && tree.Items[i + 1].Value.ItemType == FileTreeViewItem.NodeType.File)
                    return tree.Items[i + 1].Value.Path;
            }
            else if (item.Value?.ItemType == FileTreeViewItem.NodeType.Folder)
            {
                var res = FindNextVideo(path, item);
                if (!string.IsNullOrEmpty(res))
                    return res;
            }
        }

        return null;
    }

    private static readonly List<(string, string)> LangMap = [("English", ".vtt"), ("English", ".en.vtt"), ("Vietnamese", ".vn.vtt"), ("Vietnamese", ".vi.vtt")];

    private static string SrcLang(string lang) => lang switch
    {
        "Vietnamese" => "vi",
        _ => "en"
    };

    private bool videoInteropReady;

    // BlazoredVideo only creates the JS handle it drives the element through once its own
    // first render has completed, and a state push can easily beat that: signing in is a
    // real redirect now, so the page comes up with the shared state already waiting and the
    // very first thing we do is reach for a player that is not wired up yet. The interop
    // then throws, which used to vanish into the hub callback and leave a dead player.
    // Waiting also means a state arriving this early is applied instead of being dropped.
    private async Task<bool> WaitForVideoInteropAsync()
    {
        if (videoInteropReady)
            return true;

        for (var attempt = 0; attempt < 100; attempt++)
        {
            if (videoRef is not null)
            {
                try
                {
                    // Any read will do - we only care that the handle behind it exists.
                    await videoRef.GetReadyStateAsync();
                    videoInteropReady = true;
                    return true;
                }
                catch (ArgumentNullException)
                {
                    // Not wired up yet; the handle appears when its first render finishes.
                }
            }

            await Task.Delay(50);
        }

        logger.LogWarning("Client: The video element never became usable from the server.");
        return false;
    }

    // Waits for the video element to report LoadedMetadata, with a timeout fallback
    // so a stalled/broken source can't hang the sync flow forever.
    private async Task WaitForVideoReadyAsync()
    {
        var tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        pendingVideoReadyWaiters.Add(tcs);
        try
        {
            var winner = await Task.WhenAny(tcs.Task, Task.Delay(TimeSpan.FromSeconds(5)));
            if (winner != tcs.Task)
                logger.LogWarning("Client: Timed out waiting for video metadata to load.");
        }
        finally
        {
            pendingVideoReadyWaiters.Remove(tcs);
        }
    }

    private List<(string, string)> GetCaptions(string videoPath)
    {
        List<(string, string)> ret = new();
        foreach (var (lang, ending) in LangMap)
        {
            var subpath = Path.ChangeExtension(videoPath, ending);
            var realpath = subpath.Replace(Configuration.GetSection("VideoMapping")["MapTo"], Configuration.GetSection("VideoMapping")["VideoPath"]);
            if (File.Exists(realpath))
                ret.Add((lang, subpath));
        }

        return ret;
    }

    private async Task SetVideoSource(string src, bool setCaptions, string? title = null)
    {
        if (!await WaitForVideoInteropAsync())
            return;

        // Pausing and reloading below makes the player raise its own events while
        // videoSource already points at the new file. Hold those back, otherwise we
        // publish the new source together with the old video's position.
        suppressSendDepth++;
        try
        {
            videoSource = src;
            videoCaptions = setCaptions ? GetCaptions(src) : new();

            // A local file's name is its title; a YouTube source is just an id, so the
            // caller passes the real one.
            videoSourceTitle = title ?? videoSource?.Split('/').LastOrDefault() ?? "";

            var elementWasPlaying = !videoState.Paused;

            // The cached state still describes the previous video. A fresh source
            // always starts at zero, so reset before anyone can read it.
            videoState = new VideoState { Paused = true, CurrentTime = 0 };

            // A scrub send still in its debounce window belongs to the old video, and a
            // hold on the old video's sync point must not report this one as playing.
            CancelPendingSeekSend();
            CancelSyncHold();

            // The pause and the seek-to-zero below come back as events well after this
            // handler is done - they are ours, not the user's.
            var settle = new List<VideoEvents> { VideoEvents.Seeked };
            if (elementWasPlaying)
                settle.Add(VideoEvents.Pause);
            BeginSettleSuppression(settle);

            await videoRef.PausePlayback();

            // SetSrcAsync talks to the browser element directly and is what actually
            // starts the reload - it doesn't depend on Blazor's render batch having
            // reached the browser first. Relying on StateHasChanged() + ReloadControl()
            // (re-reading whatever the <source> tag's src happens to be at that moment)
            // raced the render: StateHasChanged only schedules a render, it doesn't wait
            // for the client to have applied it, so ReloadControl() could fire the
            // reload before the browser ever saw the new src - reloading the OLD/empty
            // source and leaving the element stuck at networkState=NO_SOURCE.
            await ApplySourceToPlayer(videoSource ?? "");
            await InvokeAsync(StateHasChanged);
            await WaitForVideoReadyAsync();
            await videoRef.SetCurrentTimeAsync(0);

            // Unmute after reload if not initial load
            if (!isInitialLoad) // && isMobile)
            {
                await videoRef.SetMutedAsync(false);
            }

            isInitialLoad = false;
        }
        finally
        {
            suppressSendDepth--;
        }

        // Picking a video is an explicit action: it must reach the other side even
        // though we just muted our own event stream.
        await SendState(force: true);
    }

    private readonly long maxFileSize = 2L * 1024 * 1024 * 1024;
    private bool isUploading;
    private readonly string[] supportedFormats = { ".mp4", ".m4v", ".mkv" };

    CancellationTokenSource uploadCancellationToken;

    private async Task UploadFiles(UploadFile file)
    {
        isUploading = true;

        try
        {
            var dir = Path.Combine(Configuration.GetSection("VideoMapping")["VideoPath"], "uploads");
            Directory.CreateDirectory(dir);
            var path = Path.Combine(dir, file.OriginFileName);

            if (!supportedFormats.Any(fo => path.EndsWith(fo)))
            {
                await ToastService.Error("Upload", $"Only file formats {string.Join(' ', supportedFormats)} are supported!");
            }

            if (File.Exists(path))
            {
                await ToastService.Error("Upload", $"File called {file.OriginFileName} already exists!");
            }

            uploadCancellationToken ??= new CancellationTokenSource();
            var ret = await file.SaveToFileAsync(path, maxFileSize, 1 * 1024 * 1024, uploadCancellationToken.Token);

            if (ret)
            {
                await ToastService.Success("Upload", "Upload completed");
            }
            else
            {
                var errorMessage = "Upload Failed!";
                file.Code = 1;
                file.Error = errorMessage;
                await ToastService.Error("Upload Error", errorMessage);
            }
        }
        catch (Exception ex)
        {
            logger.LogError("File: {Filename} Error: {Error}", file.OriginFileName, ex.Message);
            await ToastService.Error("Upload Error", ex.Message);
        }

        isUploading = false;
        RefreshFileTree();
    }

    // Kept as the DTO rather than flattened to strings: the rail renders the name
    // and the tab count as separate elements.
    List<UserConnectionCount> connectedUsers = new();

    private async Task RefreshConnectedUsers(List<UserConnectionCount> users)
    {
        connectedUsers = users;

        // Hub callbacks arrive off the renderer's dispatcher, so nothing repaints on
        // its own - without this the list only catches up on the next unrelated render.
        await InvokeAsync(StateHasChanged);
    }

    private List<TreeViewItem<FileTreeViewItem>> TreeViewItems { get; set; } = new();

    private void RefreshFileTree()
    {
        TreeViewItems = FileTreeViewItem.EnumerateFilesWithRootMapping(
            Configuration.GetSection("VideoMapping")["VideoPath"] ?? "",
            Configuration.GetSection("VideoMapping")["MapTo"] ?? "",
            supportedFormats);
    }

    protected override async Task OnInitializedAsync()
    {
        dotnetRef = DotNetObjectReference.Create(this);

        var userAgent = await JS.InvokeAsync<string>("eval", "navigator.userAgent");
        isMobile = userAgent.Contains("iPad") || userAgent.Contains("iPhone");

        try
        {
            ambientEnabled = await JS.InvokeAsync<bool>("videoHome.getAmbient");
        }
        catch (Exception ex)
        {
            // Not worth failing page init over - the backlight just stays at its default.
            logger.LogWarning("Could not read the ambient setting: {Error}", ex.Message);
        }

        RefreshFileTree();
        var allOptionsEnabled = new VideoStateOptions { All = true };
        foreach (var item in (VideoEvents[])Enum.GetValues(typeof(VideoEvents)))
        {
            if (item != VideoEvents.NotSet)
            {
                options[item] = allOptionsEnabled;
            }
        }

        var authstate = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        username = authstate.User?.Identity?.Name ?? "Invalid";

        var connection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/syncvideohub"), o =>
            {
                // This component runs on the server, so the hub connection is this process
                // talking to itself and carries no user cookie. The hub authorises it by
                // this token instead; it never goes near the browser.
                o.AccessTokenProvider = () => Task.FromResult<string?>(HubToken.Value);
            })
            .WithAutomaticReconnect()
            .Build();
        hubConnection = connection;

        connection.On<int, DateTimeOffset>("Ping", async (n, timestamp) =>
        {
            // Reuse the one reference we own - creating a new one per ping leaks it,
            // nothing ever disposes them.
            if (dotnetRef is not null)
                await JS.InvokeVoidAsync("ping", dotnetRef, n, timestamp).AsTask();
        });

        connection.On<VideoStateDto>("ReceiveState", StateRecieved);

        // Our own accepted update: we never receive it back as state, but its version is
        // the sync point we now have to hold at too.
        connection.On<long, bool, double>("StateAccepted", async (version, requiresSync, timestamp) =>
        {
            lastAppliedVersion = Math.Max(lastAppliedVersion, version);

            if (requiresSync)
            {
                await StartSyncHoldAsync(version, timestamp);
            }
            else
            {
                // Nothing to coordinate. Our player is already doing what we published -
                // we are the ones who did it - so there is nothing to apply either.
                CancelSyncHold();
                await InvokeAsync(StateHasChanged);
            }
        });

        // Everyone has buffered at that sync point - resume together.
        connection.On<long>("SyncRelease", ReleaseSyncHoldAsync);

        connection.On<List<UserConnectionCount>>("ConnectedUsersChanged", RefreshConnectedUsers);

        // A reconnect gets a fresh ConnectionId, so as far as the server is concerned
        // we are a stranger again: register once more or we vanish from the user list.
        connection.Reconnected += async _ =>
        {
            try
            {
                // Whatever we knew is suspect after the gap: at zero, the state that
                // RequestState answers with is applied unconditionally.
                lastAppliedVersion = 0;
                await connection.SendAsync("RegisterUser", username);
                await connection.SendAsync("RequestState");
            }
            catch (Exception ex)
            {
                logger.LogWarning("Re-registering after reconnect failed: {Error}", ex.Message);
            }
        };

        // Everything from here on is what makes the page usable at all, and none of it is
        // retried anywhere else. If the connection or the registration fails, the page would
        // otherwise sit there looking like a working player that simply never syncs - the
        // same silent failure that used to leave a joining client staring at a blank video.
        try
        {
            await connection.StartAsync();
            await connection.SendAsync("RegisterUser", username);

        // This used to be sent from OnAfterRenderAsync(firstRender: true) - but Blazor
        // paints the component's first frame immediately once OnInitializedAsync starts
        // an async operation, it does not wait for this method to finish. That first
        // render (and its OnAfterRenderAsync(firstRender: true) callback) reliably fired
        // before execution reached this point, back when hubConnection was still null,
        // so RequestState was skipped - and since firstRender is only ever true once,
        // it was never retried. A freshly joined client would register with the hub but
        // never actually ask it for the current video, staying blank until someone
        // else's unrelated action happened to push a new state.
            await JS.InvokeVoidAsync("ping", dotnetRef, 0, DateTimeOffset.UtcNow).AsTask();
            await connection.SendAsync("RequestState");
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Could not join the sync session.");
            await ToastService.Error("Sync", "Could not connect to the sync session - reload the page to retry.");
        }
    }

    [JSInvokable("Pong")]
    public async Task Pong(int n, DateTimeOffset timestamp)
    {
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("Pong", n, timestamp);
        }
        else
        {
            logger.LogInformation("Hub was disposed!");
        }
    }

    private VideoStateDto GetStateDto()
    {
        return new VideoStateDto
        {
            // While holding for a sync point the element is paused, but the shared
            // intent is to play - reporting the element's state would tell the others
            // we had paused and stop the very playback the hold is preparing.
            IsPlaying = IsHoldingForSync || !videoState.Paused,
            Source = videoSource,
            Title = videoSourceTitle,
            CaptionsLang = videoCaptions.Select(t => t.Item1).ToList(),
            CaptionsPath = videoCaptions.Select(t => t.Item2).ToList(),
            VideoTimestamp = videoState.CurrentTime,
            Duration = videoState.Duration,

            // Lets the server order our sends among themselves and detect a report
            // composed before an in-flight broadcast reached us. Version stays 0 -
            // that stamp is the server's alone.
            ClientSequence = ++clientSequence,
            BasedOnVersion = lastAppliedVersion
        };
    }

    private bool isInitialLoad = true;

    private async Task StateRecieved(VideoStateDto newstate)
    {
        // A version we have already applied, or been overtaken past. Duplicates are
        // normal, not an error: the hub re-sends the current state whenever it rejects
        // an update, and that usually names a version this client has long applied.
        if (newstate.Version != 0 && newstate.Version <= lastAppliedVersion)
        {
            logger.LogInformation("Client: Ignoring state v{Version}, already at v{Applied}.",
                newstate.Version, lastAppliedVersion);
            return;
        }

        // Not "give up if the player isn't ready": a freshly loaded page gets its state
        // pushed immediately, so bailing out here would drop the only update it receives.
        if (!await WaitForVideoInteropAsync())
            return;

        if (newstate.Version != 0)
            lastAppliedVersion = newstate.Version;

        // Whatever local scrub was waiting to be published is stale now: this state
        // supersedes it, and sending it later would fight the sender.
        CancelPendingSeekSend();

        suppressSendDepth++;
        try
        {
            logger.LogInformation($"Client: State recieved. {newstate.Source?.Split('/').LastOrDefault()} {newstate.IsPlaying} {newstate.VideoTimestamp}");

            if (newstate.Source != videoSource)
            {
                logger.LogInformation("Client: Setting video source.");
                videoSource = newstate.Source;
                videoCaptions = newstate.CaptionsLang.Zip(newstate.CaptionsPath).ToList();
                videoSourceTitle = string.IsNullOrEmpty(newstate.Title)
                    ? videoSource?.Split('/').LastOrDefault() ?? ""
                    : newstate.Title;

                // Cached state belongs to the previous video - a new source is at zero.
                videoState = new VideoState { Paused = true, CurrentTime = 0 };

                // A fresh source loads paused, whatever we had asked of the old one.
                pauseIssued = false;

                if (!string.IsNullOrEmpty(videoSource))
                {
                    // SetSrcAsync talks to the browser element directly instead of
                    // going through the <source> tag + StateHasChanged()/ReloadControl(),
                    // which raced the render batch reaching the client (StateHasChanged
                    // only schedules a render, it doesn't wait for delivery) and could
                    // fire the reload against the still-old/empty source.
                    await ApplySourceToPlayer(videoSource);
                    await InvokeAsync(StateHasChanged);

                    // This used to only be waited for when !isInitialLoad (it was tied
                    // to the unmute step below), so the very first video a client ever
                    // loaded - exactly the case when someone freshly joins a session -
                    // went straight into seeking/playing with zero time for the browser
                    // to fetch metadata. That race is why a newly joined client would
                    // sometimes just not show the video until some later, unrelated
                    // update happened to retrigger the seek.
                    await WaitForVideoReadyAsync();

                    // Unmute after reload if not initial load
                    if (!isInitialLoad) // && isMobile)
                    {
                        await videoRef.SetMutedAsync(false);
                    }

                    isInitialLoad = false;
                }
            }

            var willSeek = Math.Abs(newstate.VideoTimestamp - videoState.CurrentTime) > 0.5;

            // What the driving below will make the player raise, registered before the
            // first call so an event that comes back mid-handler is consumed too. Only
            // real transitions: play() on an already-playing element raises nothing, and
            // waiting for an event that never comes would mute us until the timeout.
            var settle = new List<VideoEvents>();
            if (willSeek)
                settle.Add(VideoEvents.Seeked);
            BeginSettleSuppression(settle);

            // Seek before starting playback, not after: seeking post-play briefly
            // shows/plays frame 0 of the new source before jumping to the synced spot.
            if (willSeek)
            {
                logger.LogInformation("Client: Setting time to {Timestamp}.", newstate.VideoTimestamp);
                await videoRef.SetCurrentTimeAsync(newstate.VideoTimestamp);
                videoState.CurrentTime = newstate.VideoTimestamp;
            }

            if (newstate.IsPlaying && newstate.RequiresSync)
            {
                // Resuming somewhere we may not have buffered: hold here until every
                // client reports it has, then the hub starts us all together.
                await StartSyncHoldAsync(newstate.Version, newstate.VideoTimestamp);
            }
            else if (newstate.IsPlaying)
            {
                // Playing on from a spot nobody moved away from. Both sides already hold
                // the media, so start now - waiting would only add a stutter, and the
                // player is where the sender's was when they pressed play.
                CancelSyncHold();
                await StartPlaybackForSyncAsync();
            }
            else
            {
                logger.LogInformation("Client: Pausing playback.");
                CancelSyncHold();
                await PauseForSyncAsync();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // This runs as a hub callback, so anything thrown here is simply dropped by
            // SignalR: the player would be left half-configured with nothing logged, which
            // looks exactly like the video "just not loading".
            logger.LogError(ex, "Client: Failed to apply received state.");
        }
        finally
        {
            // In a finally so a failed interop call cannot leave this client mute
            // for the rest of the session.
            suppressSendDepth--;
        }
    }

    // Registers the events the driving we are about to do will raise. Any previous
    // expectation is cleared: the newest application of state is the one that counts.
    private void BeginSettleSuppression(List<VideoEvents> events)
    {
        lock (settleLock)
        {
            expectedSettleEvents.Clear();
            foreach (var e in events)
                expectedSettleEvents.Add(e);
            settleDeadline = DateTimeOffset.UtcNow.AddSeconds(SETTLE_TIMEOUT_SECONDS);
        }
    }

    // Extends the current expectation instead of replacing it: the barrier registers
    // its pause and, later, its resume while a seek from the same operation may still
    // be settling, and clearing that would let the seek's own events out as if the
    // user had made them.
    private void AddSettleExpectations(params VideoEvents[] events)
    {
        lock (settleLock)
        {
            foreach (var e in events)
                expectedSettleEvents.Add(e);
            settleDeadline = DateTimeOffset.UtcNow.AddSeconds(SETTLE_TIMEOUT_SECONDS);
        }
    }

    private bool SettleSuppressionActive()
    {
        lock (settleLock)
        {
            if (expectedSettleEvents.Count == 0)
                return false;
            if (DateTimeOffset.UtcNow < settleDeadline)
                return true;

            logger.LogWarning("Client: Still waiting on {Events} after {Timeout}s - releasing send suppression.",
                string.Join(", ", expectedSettleEvents), SETTLE_TIMEOUT_SECONDS);
            expectedSettleEvents.Clear();
            return false;
        }
    }

    private bool ConsumeExpectedSettleEvent(VideoEvents eventName)
    {
        lock (settleLock)
        {
            if (expectedSettleEvents.Count == 0)
                return false;
            if (DateTimeOffset.UtcNow >= settleDeadline)
            {
                expectedSettleEvents.Clear();
                return false;
            }

            return expectedSettleEvents.Remove(eventName);
        }
    }

    private void CancelPendingSeekSend()
    {
        pendingSeekSend = false;
        seekSendDebounce?.Cancel();
    }

    private void ScheduleSeekSend()
    {
        // Dropped rather than delayed while suppression is active: a suppressed Seeking
        // is the applied remote state moving our player, and a send merely postponed to
        // after suppression lifts would still echo that seek back.
        if (suppressSendDepth > 0 || SettleSuppressionActive())
            return;

        seekSendDebounce?.Cancel();
        var cts = new CancellationTokenSource();
        seekSendDebounce = cts;
        pendingSeekSend = true;
        _ = RunSeekSendAsync(cts.Token);
    }

    private async Task RunSeekSendAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(SEEK_SEND_DEBOUNCE_MS, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested)
            return;

        pendingSeekSend = false;
        try
        {
            // SendState reads the cached state fresh, so this carries where the
            // scrubbing ended up, not where it passed through when the timer started.
            await SendState();
        }
        catch (Exception ex)
        {
            logger.LogWarning("Sending state failed: {Error}", ex.Message);
        }
    }

    // Pausing without leaving a dangling expectation behind if the element was already
    // paused. Every pause the sync layer performs goes through here.
    private async Task PauseForSyncAsync()
    {
        if (videoState.Paused || pauseIssued)
            return;

        pauseIssued = true;
        AddSettleExpectations(VideoEvents.Pause);
        try
        {
            await videoRef.PausePlayback();
        }
        catch (Exception ex)
        {
            logger.LogWarning("Pausing failed: {Error}", ex.Message);

            // The event is never coming, so give the expectation back rather than
            // staying mute until the deadline.
            pauseIssued = false;
            ConsumeExpectedSettleEvent(VideoEvents.Pause);
        }
    }

    // How far the playhead may sit from the agreed sync point before it is worth a
    // seek. Below this a correction costs more than it buys: a seek can drop the
    // buffer dash.js has built up and turn a fraction of a second into a real stall.
    private const double SYNC_POINT_TOLERANCE_SECONDS = 0.25;

    private async Task AlignToSyncPointAsync(double position)
    {
        if (double.IsNaN(position) || position < 0)
            return;

        var expectationAdded = false;
        try
        {
            // Read from the element: videoState.CurrentTime only moves when TimeUpdate
            // arrives, which is exactly the lag being corrected for here.
            var actual = await videoRef.GetCurrentTimeAsync();
            if (Math.Abs(actual - position) <= SYNC_POINT_TOLERANCE_SECONDS)
                return;

            logger.LogInformation("Client: Aligning {Actual}s onto the sync point at {Position}s.", actual, position);

            AddSettleExpectations(VideoEvents.Seeked);
            expectationAdded = true;

            await videoRef.SetCurrentTimeAsync(position);
            videoState.CurrentTime = position;
        }
        catch (Exception ex)
        {
            logger.LogWarning("Client: could not align onto the sync point: {Error}", ex.Message);

            // No seek happened, so nothing will settle that expectation.
            if (expectationAdded)
                ConsumeExpectedSettleEvent(VideoEvents.Seeked);
        }
    }

    // Holds the playhead at an agreed position until every client has buffered there.
    // Entered from both directions - a state we received, and one of ours the hub
    // accepted - because the client that acted has to wait for the others just as much.
    private async Task StartSyncHoldAsync(long version, double position)
    {
        // A state from before versioning, or one the hub never stamped: nothing can
        // release a hold on it, so keep the old behaviour and just play.
        if (version <= 0)
        {
            await StartPlaybackForSyncAsync();
            return;
        }

        // The release went out before we were holding - or before the hub counted us at
        // all. Waiting for a second one would mean sitting still for the fallback.
        if (lastReleasedVersion >= version)
        {
            logger.LogInformation("Client: v{Version} was already released; playing without holding.", version);
            await StartPlaybackForSyncAsync();
            return;
        }

        var isNewHold = holdingForVersion != version;
        holdingForVersion = version;

        holdCts?.Cancel();
        var cts = new CancellationTokenSource();
        holdCts = cts;

        // Hold where everyone agreed the playhead is. Doing this on the client that
        // seeked as well is the entire point: the wait then costs both sides the same.
        await PauseForSyncAsync();

        // Only now that nothing is advancing any more, put the playhead exactly on the
        // sync point. The client that acted has usually played on a little since it
        // published that position - the scrub debounce and the round trip both cost
        // real time - and resuming from where it drifted to would hand back a slice of
        // the very offset this is here to remove.
        await AlignToSyncPointAsync(position);

        if (isNewHold)
            await InvokeAsync(StateHasChanged);

        // Detached: the buffer wait takes as long as the network takes, and this runs on
        // the hub connection's dispatch loop - blocking it would keep the very release
        // this is waiting for from ever being delivered.
        _ = RunSyncHoldAsync(version, cts.Token);
    }

    private async Task RunSyncHoldAsync(long version, CancellationToken token)
    {
        try
        {
            bool ready;
            try
            {
                // The feedback signal: resolves once the browser has media at the
                // playhead and enough after it to keep going.
                ready = await JS.InvokeAsync<bool>("videoHome.waitUntilReady", token, READY_TIMEOUT_MS);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (Exception ex)
            {
                // Report in anyway below: a client that cannot answer must not be able
                // to keep everyone else paused.
                logger.LogWarning("Client: could not wait for the buffer: {Error}", ex.Message);
                ready = false;
            }

            if (token.IsCancellationRequested)
                return;

            if (!ready)
            {
                logger.LogWarning(
                    "Client: still not buffered at {Position}s after {Timeout}ms - reporting ready anyway.",
                    videoState.CurrentTime, READY_TIMEOUT_MS);
            }

            if (hubConnection is not null)
                await hubConnection.SendAsync("ReportReady", version, cancellationToken: token);

            await Task.Delay(TimeSpan.FromSeconds(RELEASE_FALLBACK_SECONDS), token);

            if (holdingForVersion != version)
                return;

            // Long enough. Ask the hub to let everyone go at once rather than starting
            // on our own: whatever went wrong, the two sides resuming at whichever
            // moment each happened to give up is worse than both resuming late.
            logger.LogWarning("Client: no release for v{Version} arrived - asking for one.", version);
            if (hubConnection is not null)
                await hubConnection.SendAsync("ForceRelease", version, cancellationToken: token);

            await Task.Delay(TimeSpan.FromSeconds(FORCED_RELEASE_GRACE_SECONDS), token);

            // Not even that came back, so the hub is not going to answer. Play rather
            // than leave the player parked indefinitely.
            if (holdingForVersion == version)
            {
                logger.LogWarning("Client: v{Version} was never released - resuming on our own.", version);
                await ReleaseSyncHoldAsync(version);
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer sync point, or the page is going away.
        }
        catch (Exception ex)
        {
            logger.LogWarning("Client: the sync hold for v{Version} failed: {Error}", version, ex.Message);

            // Never leave the player parked because the bookkeeping broke.
            await ReleaseSyncHoldAsync(version);
        }
    }

    private async Task ReleaseSyncHoldAsync(long version)
    {
        lastReleasedVersion = Math.Max(lastReleasedVersion, version);

        if (holdingForVersion != version)
        {
            // A release for a sync point we have already left. Normal: the hub sends it
            // to everyone, and by then someone may have seeked again.
            logger.LogInformation("Client: ignoring the release for v{Version}, holding at {Held}.",
                version, holdingForVersion?.ToString() ?? "nothing");
            return;
        }

        holdingForVersion = null;
        holdCts?.Cancel();

        await StartPlaybackForSyncAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartPlaybackForSyncAsync()
    {
        // The shared state already says playing, so these events carry nothing new -
        // and sending on them would ask the hub for another sync point on top of the
        // one we are finishing, over and over.
        //
        // Only when there is a transition to expect, though: play() on an element that
        // is already playing raises nothing, and an expectation nothing will settle
        // keeps this client mute until the deadline.
        var expectingPlayback = videoState.Paused || pauseIssued;
        if (expectingPlayback)
            AddSettleExpectations(VideoEvents.Play, VideoEvents.Playing);

        pauseIssued = false;

        try
        {
            logger.LogInformation("Client: Starting playback.");
            await videoRef.StartPlayback();
        }
        catch (Exception ex)
        {
            logger.LogWarning("Autoplay failed: {Error}", ex.Message);

            // Nothing will settle those two now. Given back individually rather than
            // clearing the set, which may also be holding a seek from the same operation.
            if (expectingPlayback)
            {
                ConsumeExpectedSettleEvent(VideoEvents.Play);
                ConsumeExpectedSettleEvent(VideoEvents.Playing);
            }
        }
    }

    private void CancelSyncHold()
    {
        holdingForVersion = null;
        holdCts?.Cancel();
    }

    private async Task SendState(bool force = false)
    {
        if (!force && (suppressSendDepth > 0 || SettleSuppressionActive()))
            return;

        var newstate = GetStateDto();
        logger.LogInformation($"Client: Sending state. {newstate.Source?.Split('/')?.LastOrDefault()} " +
                              $" {newstate.IsPlaying} {newstate.VideoTimestamp}");

        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("UpdateState", newstate);
        }
    }

    // EventFired is an Action, so the component cannot await us. Start the async part
    // separately rather than making this async void, where a failed send would go
    // unobserved and tear down the circuit.
    private void OnEvent(VideoEventData videoData) => _ = HandleVideoEvent(videoData);

    private async Task HandleVideoEvent(VideoEventData videoData)
    {
        var wasPaused = videoState.Paused;
        videoState = videoData.State;

        // The paused flag feeds the .is-paused class on the frame. Events do not
        // repaint on their own (StateHasChanged below stays commented out for good
        // reason), so without this nudge the class only catches up on the next
        // unrelated render. Only on a flip - TimeUpdate arrives constantly.
        if (videoState.Paused != wasPaused)
            await InvokeAsync(StateHasChanged);

        // The element has now told us where it stands, so a pause we asked for is
        // either done or moot.
        if (videoData.EventName is VideoEvents.Pause or VideoEvents.Play or VideoEvents.Playing)
            pauseIssued = false;

        if (videoData.EventName == VideoEvents.LoadedMetadata)
        {
            // There is only one <video> element, so any LoadedMetadata means whatever
            // reload is in flight is now ready - release everyone waiting on it.
            foreach (var waiter in pendingVideoReadyWaiters.ToArray())
                waiter.TrySetResult(true);
        }

        // The tail of something we drove ourselves (remote update, source switch, skip
        // button): the event confirms the player has settled, it is not a user action.
        if (ConsumeExpectedSettleEvent(videoData.EventName))
        {
            logger.LogInformation("Client: OnEvent: {Event} settles our own driving at {Position}.",
                videoData.EventName, videoState.CurrentTime);
            return;
        }

        switch (videoData.EventName)
        {
            case VideoEvents.Seeking:
                logger.LogInformation($"Client: OnEvent: {videoData.EventName} {videoState.CurrentTime}");
                ScheduleSeekSend();
                break;

            case VideoEvents.Playing when pendingSeekSend:
                // Playback resuming mid-scrub; the debounced send already covers it.
                break;

            case VideoEvents.Play:
            case VideoEvents.Playing:
            case VideoEvents.Pause:
                // Carries the full, freshest state - anything the seek debounce was
                // still holding back is superseded by this send.
                CancelPendingSeekSend();
                logger.LogInformation($"Client: OnEvent: {videoData.EventName} {videoState.CurrentTime}");
                try
                {
                    await SendState();
                }
                catch (Exception ex)
                {
                    logger.LogWarning("Sending state failed: {Error}", ex.Message);
                }
                break;
        }
        @* StateHasChanged(); *@
    }

    public async ValueTask DisposeAsync()
    {
        logger.LogInformation("Client: Disposing razor page.");

        CancelPendingSeekSend();
        CancelSyncHold();

        if (hubConnection is not null)
        {
            try
            {
                await hubConnection.DisposeAsync();
            }
            catch (Exception ex)
            {
                logger.LogWarning("Error disposing hub connection: {Error}", ex.Message);
            }
        }

        dotnetRef?.Dispose();
        dotnetRef = null;

        if (uploadCancellationToken is not null)
        {
            await uploadCancellationToken.CancelAsync();
            uploadCancellationToken.Dispose();
        }

        GC.SuppressFinalize(this);
    }
}