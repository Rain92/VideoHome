<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BootstrapBlazor" Version="10.9.0" />
    <PackageReference Include="BootstrapBlazor.FontAwesome" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Blazored.Video" Version="1.0.1" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
    <PackageReference Include="SoloX.BlazorLayout" Version="1.0.0-alpha.9" />
    <PackageReference Include="YoutubeExplode" Version="6.6.0" />
    <!-- YoutubeExplode pulls in AngleSharp 1.4.0, which carries GHSA-pgww-w46g-26qg
         (fixed in 1.5.0). Referenced directly only to lift that transitive version.
         Do not bump blindly: 1.7.0 builds fine but breaks YoutubeExplode's page parsing
         at runtime, so /youtube/{id} starts returning 500. Re-run the youtube check
         after any change here. -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="users.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' != '' AND '$(Configuration)' == 'Debug' ">
    <EnvironmentName>Development</EnvironmentName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' != '' AND '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

</Project>
